# 白名单模式：默认忽略所有文件和目录，通过 ! 显式放行需要同步的配置
*
!.gitignore
!.gitmodules

# ── 文档 ──────────────────────────────────────────────
!CLAUDE.md
!README.md
!documents/
!documents/**

# ── 初始化脚本 ────────────────────────────────────────
!setup.py
!setup_dep/
!setup_dep/**
!sync.sh
!dep.txt
!dep_macos.txt

# ── Zsh ──────────────────────────────────────────────
!zsh/
!zsh/**
zsh/plugins/

# ── Neovim ───────────────────────────────────────────
!nvim/
nvim/*
!nvim/init.lua
!nvim/lazy-lock.json
!nvim/lua/
!nvim/lua/**

# ── Neovim (VimScript 备份) ───────────────────────────
!nvim.vim.bak/
!nvim.vim.bak/**

# ── Alacritty ────────────────────────────────────────
!alacritty/
!alacritty/**

# ── Tmux ─────────────────────────────────────────────
!tmux/
!tmux/**
tmux/plugins/

# ── Zellij ───────────────────────────────────────────
!zellij/
!zellij/**
zellij/plugins/

# ── Yazi ─────────────────────────────────────────────
!yazi/
yazi/*
!yazi/init.lua
!yazi/package.toml
!yazi/yazi.toml
!yazi/keymap.toml
!yazi/theme.toml

# ── Ghostty ──────────────────────────────────────────
!ghostty/
!ghostty/**

# ── Aerospace ────────────────────────────────────────
!aerospace/
!aerospace/**

# ── Lazygit ──────────────────────────────────────────
!lazygit/
!lazygit/**

# ── Scripts ──────────────────────────────────────────
!scripts/
!scripts/**

# ── Themes ───────────────────────────────────────────
!themes/
!themes/**

# ── Bat ──────────────────────────────────────────────
!bat/
!bat/**

# ── Neofetch ─────────────────────────────────────────
!neofetch/
!neofetch/**

# ── Bottom (系统监视器) ──────────────────────────────
!bottom/
!bottom/**

# ── Git 全局配置 (ignore / attributes) ──────────────
!git/
!git/**

# ── Python 编译缓存（黑名单） ─────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo
**/.claude/
**/*_cache*

# ── 运行时快照（含内部模型目录，勿入库） ─────────────
zsh/fzf/claude/model_snapshots.json

# ── Thirdparty submodules ────────────────────────────
!thirdparty/
thirdparty/*
!thirdparty/fzf/
!thirdparty/tpm/

# -- gh --
!gh/
!gh/**

# ── Pi Coding Agent ─────────────────────────────────
pi/

# -- starship
!starship/
!starship/**
